<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- SEQUENTIAL suite: one scenario at a time, in feature order.
     Run with:  mvn verify -Dsuite=testng-sequential
     Use this for debugging, or for APIs with shared mutable state / rate limits. -->
<suite name="API Suite (sequential)" data-provider-thread-count="1" preserve-order="true" verbose="1">

    <listeners>
        <listener class-name="com.Restful_booker.api.listeners.TestListener"/>
        <listener class-name="com.Restful_booker.api.listeners.RetryTransformer"/>
    </listeners>

    <test name="All API scenarios" preserve-order="true">
        <classes>
            <class name="com.Restful_booker.api.runners.TestRunner"/>
        </classes>
    </test>
</suite>
