<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- PARALLEL suite (default). Scenarios run concurrently; override the thread
     count with:  mvn verify -Dthread.count=8 -->
<suite name="API Suite (parallel)" data-provider-thread-count="${thread.count}" verbose="1">

    <listeners>
        <listener class-name="com.Restful_booker.api.listeners.TestListener"/>
        <listener class-name="com.Restful_booker.api.listeners.RetryTransformer"/>
    </listeners>

    <test name="All API scenarios">
        <classes>
            <class name="com.Restful_booker.api.runners.TestRunner"/>
        </classes>
    </test>
</suite>
